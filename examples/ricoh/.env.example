# printer-web + ricoh-spc240 (Ricoh Aficio SP C240DN, port 9100).
# Build:  docker build -t printer-web-ricoh examples/ricoh
# Run:    docker run -d --name printer-web --restart unless-stopped \
#           -p 28431:28431 --env-file examples/ricoh/.env printer-web-ricoh
PRINTER_NAME=Office printer
PRINTER_BACKEND=command

# Printer address goes after --printer. Every token below is always non-empty
# ({paper} falls back to the first PRINTER_PAPERS entry), so no flag is ever
# followed by another flag. {mono_flag} / {landscape_flag} expand to
# --mono / --landscape only when needed.
PRINTER_COMMAND=["ricoh-spc240","print","{file}","--printer","192.168.1.50","--duplex","{duplex}","--copies","{copies}","--paper","{paper}","{mono_flag}","{landscape_flag}"]
# Same address, port 9100: the page shows the printer as off when it does
# not answer, and jobs are not sent to it.
PRINTER_PROBE=192.168.1.50:9100
# Same address again, for toner levels and paper/jam/cover alerts (SNMP v1,
# community "public").
PRINTER_SNMP=192.168.1.50

PRINTER_COLOR=true
PRINTER_DUPLEX=true
PRINTER_PAPERS=A4,A5,Letter,Legal
PRINTER_MODEL=Ricoh Aficio SP C240DN
