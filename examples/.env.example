# printer-web configuration. Copy to .env and use: docker run --env-file .env
# Every variable is optional except the printer address (or command).

# --- Server -----------------------------------------------------------------
# Address and port to listen on.
LISTEN_ADDR=:28431
# Address people type or scan (used by the QR poster). Set it when you reach
# the app through a custom DNS name or a single-label host such as "printbox".
#PUBLIC_URL=http://192.168.1.10:28431
# Interface language: auto (browser language), fr or en.
DEFAULT_LANG=auto
# Show other people's file names in the shared queue.
QUEUE_SHOW_NAMES=false
# Uploaded files are forgotten after this long if never printed (Go duration).
DRAFT_TTL=15m
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=50

# --- Printer ----------------------------------------------------------------
# Name and place shown in the UI and on the QR poster.
PRINTER_NAME=Printer
PRINTER_LOCATION=
# Backend: ipp (default), cups, raw or command.
PRINTER_BACKEND=ipp
# ipp/cups: ipp://host/ipp/print  (ipps:// also works). raw: socket://host[:9100]
PRINTER_URI=ipp://192.168.1.50/ipp/print
# Accept a self-signed certificate on ipps:// printers.
PRINTER_TLS_INSECURE=false
# raw backend only: language sent to the printer, ps or pcl.
PRINTER_RAW_LANGUAGE=ps
# command backend only: JSON array of strings, run without a shell.
#PRINTER_COMMAND=["lp","-d","office","-n","{copies}","{file}"]

# --- Declared capabilities (raw and command backends) -------------------------
# ipp/cups read these from the printer. Names must not contain spaces.
PRINTER_COLOR=false
PRINTER_DUPLEX=false
PRINTER_PAPERS=A4
PRINTER_TRAYS=
# Optional information shown on the printer page.
PRINTER_MODEL=
PRINTER_PPM=0
PRINTER_DPI=0

# --- Cost estimate (all optional) ---------------------------------------------
# Currency symbol and paper cost per sheet (decimal point).
PRICE_CURRENCY=€
#PRICE_SHEET=0.01
# Cartridge price and yield in pages at 5 % coverage, per colour (C, M, Y, K).
# Set both PRICE_TONER_x and YIELD_TONER_x, or neither.
#PRICE_TONER_K=60
#YIELD_TONER_K=3000
#PRICE_TONER_C=80
#YIELD_TONER_C=2500
#PRICE_TONER_M=80
#YIELD_TONER_M=2500
#PRICE_TONER_Y=80
#YIELD_TONER_Y=2500
